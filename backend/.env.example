# Copy this file to .env and replace the values with your own credentials.
# Never commit .env or put production secrets in this template.

APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHRONICLE_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Local development default. Replace with your Neon pooled URL when needed.
# Neon: use the pooled URL for app queries and the direct URL for schema setup.
DATABASE_URL=sqlite:///./chronicle.sqlite3
# DIRECT_URL=

# Google Identity Services Web application client ID.
GOOGLE_CLIENT_ID=

# Optional SMTP settings for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional ImageKit configuration (currently unused by the local upload flow).
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
