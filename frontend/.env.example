# Add the origin serving the browser app to Authorized JavaScript origins in
# Google Cloud Console. The built frontend is served by FastAPI on port 8000;
# add the Vite origin too only when using its development server.
# http://localhost:8000
# http://localhost:5173
# http://127.0.0.1:5173
# This GIS ID-token flow does not need an Authorized redirect URI.
VITE_GOOGLE_CLIENT_ID=

# Optional when the API is hosted on a separate origin. Vite proxies /api in development.
# VITE_API_BASE_URL=https://api.example.com/api
