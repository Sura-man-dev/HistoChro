# Optional. Google Cloud Console: add both local frontend origins under
# Authorized JavaScript origins for the Web application OAuth client. This app
# uses the GIS ID-token flow, so it does not need an Authorized redirect URI.
# http://localhost:5173
# http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=

# Optional when the API is hosted on a separate origin. Vite proxies /api in development.
# VITE_API_BASE_URL=https://api.example.com/api
